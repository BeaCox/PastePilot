{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pastepilot.app/schemas/local-action-plugin-manifest-v1.schema.json",
  "title": "PastePilot Local Action Plugin Manifest v1",
  "description": "A bounded, declarative local action plugin for PastePilot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identifier",
    "name",
    "version",
    "contentTypes",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "identifier": {
      "$ref": "#/$defs/identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "contentTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/contentType"
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "contentType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "matcher"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "matcher": {
          "$ref": "#/$defs/matcher"
        }
      }
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pattern"
      ],
      "properties": {
        "type": {
          "enum": [
            "literal",
            "regularExpression"
          ]
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "caseSensitive": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "template",
        "contentTypes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "detail": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "contentTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
